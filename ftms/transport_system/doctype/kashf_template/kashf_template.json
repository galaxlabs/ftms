{
  "doctype": "DocType",
  "name": "Kashf Template",
  "module": "Transport System",
  "autoname": "field:template_name",
  "engine": "InnoDB",
  "field_order": ["template_name", "service_type", "country", "column_break_template", "enabled", "language", "provider_identity_source", "show_passenger_documents", "show_passenger_mobile", "show_qr", "section_branding", "company_logo_field", "company_stamp_field", "driver_provider_name_field", "vehicle_card_field", "vehicle_ownership_field", "footer_text"],
  "fields": [
    {"fieldname": "template_name", "fieldtype": "Data", "label": "Template Name", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "service_type", "fieldtype": "Link", "label": "Service Type", "options": "Service Type"},
    {"fieldname": "country", "fieldtype": "Link", "label": "Country", "options": "Country"},
    {"fieldname": "column_break_template", "fieldtype": "Column Break"},
    {"fieldname": "enabled", "fieldtype": "Check", "label": "Enabled", "default": "1", "in_list_view": 1},
    {"fieldname": "language", "fieldtype": "Select", "label": "Language", "options": "English\nArabic\nBilingual", "default": "Bilingual"},
    {"fieldname": "provider_identity_source", "fieldtype": "Select", "label": "Provider Identity Source", "options": "Verified Company First\nDriver Provider First\nCompany Only\nDriver Only", "default": "Verified Company First"},
    {"fieldname": "show_passenger_documents", "fieldtype": "Check", "label": "Show Passenger Documents", "default": "0"},
    {"fieldname": "show_passenger_mobile", "fieldtype": "Check", "label": "Show Passenger Mobile", "default": "1"},
    {"fieldname": "show_qr", "fieldtype": "Check", "label": "Show QR", "default": "1"},
    {"fieldname": "section_branding", "fieldtype": "Section Break", "label": "Provider Branding"},
    {"fieldname": "company_logo_field", "fieldtype": "Data", "label": "Company Logo Field", "default": "logo"},
    {"fieldname": "company_stamp_field", "fieldtype": "Data", "label": "Company Stamp Field", "default": "stamp_image"},
    {"fieldname": "driver_provider_name_field", "fieldtype": "Data", "label": "Driver Provider Name Field", "default": "provider_name"},
    {"fieldname": "vehicle_card_field", "fieldtype": "Data", "label": "Vehicle Card Field", "default": "vehicle_card_document"},
    {"fieldname": "vehicle_ownership_field", "fieldtype": "Data", "label": "Vehicle Ownership Field", "default": "vehicle_ownership_document"},
    {"fieldname": "footer_text", "fieldtype": "Small Text", "label": "Footer Text"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
