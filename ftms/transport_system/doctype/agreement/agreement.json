{
  "doctype": "DocType",
  "name": "Agreement",
  "module": "Transport System",
  "autoname": "format:AGR-{YYYY}-{#####}",
  "engine": "InnoDB",
  "is_submittable": 1,
  "field_order": ["agreement_title", "customer_company", "provider_company", "service_type", "status", "column_break_identity", "agreement_template", "version", "start_date", "end_date", "section_order", "order", "trip", "currency", "agreed_amount", "platform_commission", "provider_settlement", "column_break_amounts", "payment_terms", "cancellation_policy", "waiting_policy", "section_acceptance", "customer_accepted_by", "customer_accepted_on", "provider_accepted_by", "provider_accepted_on", "agreement_document"],
  "fields": [
    {"fieldname": "agreement_title", "fieldtype": "Data", "label": "Agreement Title", "reqd": 1, "in_list_view": 1},
    {"fieldname": "customer_company", "fieldtype": "Link", "label": "Customer Company", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "provider_company", "fieldtype": "Link", "label": "Provider Company", "options": "Company", "reqd": 1, "in_list_view": 1},
    {"fieldname": "service_type", "fieldtype": "Link", "label": "Service Type", "options": "Service Type"},
    {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nSent to Customer\nSent to Provider\nAccepted\nActive\nCompleted\nCancelled\nDisputed\nExpired", "default": "Draft", "in_list_view": 1},
    {"fieldname": "column_break_identity", "fieldtype": "Column Break"},
    {"fieldname": "agreement_template", "fieldtype": "Link", "label": "Agreement Template", "options": "Agreement Template"},
    {"fieldname": "version", "fieldtype": "Int", "label": "Version", "default": "1"},
    {"fieldname": "start_date", "fieldtype": "Date", "label": "Start Date"},
    {"fieldname": "end_date", "fieldtype": "Date", "label": "End Date"},
    {"fieldname": "section_order", "fieldtype": "Section Break", "label": "Order and Amounts"},
    {"fieldname": "order", "fieldtype": "Link", "label": "Order", "options": "Trip Booking"},
    {"fieldname": "trip", "fieldtype": "Link", "label": "Trip", "options": "Trip"},
    {"fieldname": "currency", "fieldtype": "Link", "label": "Currency", "options": "Currency", "default": "SAR"},
    {"fieldname": "agreed_amount", "fieldtype": "Currency", "label": "Agreed Amount"},
    {"fieldname": "platform_commission", "fieldtype": "Currency", "label": "Platform Commission"},
    {"fieldname": "provider_settlement", "fieldtype": "Currency", "label": "Provider Settlement"},
    {"fieldname": "column_break_amounts", "fieldtype": "Column Break"},
    {"fieldname": "payment_terms", "fieldtype": "Small Text", "label": "Payment Terms"},
    {"fieldname": "cancellation_policy", "fieldtype": "Small Text", "label": "Cancellation Policy"},
    {"fieldname": "waiting_policy", "fieldtype": "Small Text", "label": "Waiting/No-show Policy"},
    {"fieldname": "section_acceptance", "fieldtype": "Section Break", "label": "Acceptance"},
    {"fieldname": "customer_accepted_by", "fieldtype": "Link", "label": "Customer Accepted By", "options": "User"},
    {"fieldname": "customer_accepted_on", "fieldtype": "Datetime", "label": "Customer Accepted On"},
    {"fieldname": "provider_accepted_by", "fieldtype": "Link", "label": "Provider Accepted By", "options": "User"},
    {"fieldname": "provider_accepted_on", "fieldtype": "Datetime", "label": "Provider Accepted On"},
    {"fieldname": "agreement_document", "fieldtype": "Attach", "label": "Agreement Document"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}, {"role": "Desk User", "read": 1, "create": 1, "write": 1}]
}
