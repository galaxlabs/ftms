{
  "doctype": "DocType",
  "name": "Feature Flag",
  "module": "Transport System",
  "autoname": "field:flag_key",
  "engine": "InnoDB",
  "field_order": ["flag_key", "enabled", "column_break_scope", "country", "company", "role", "platform", "section_schedule", "start_date", "end_date", "rollout_percentage"],
  "fields": [
    {"fieldname": "flag_key", "fieldtype": "Data", "label": "Flag Key", "reqd": 1, "unique": 1, "in_list_view": 1},
    {"fieldname": "enabled", "fieldtype": "Check", "label": "Enabled", "default": "0", "in_list_view": 1},
    {"fieldname": "column_break_scope", "fieldtype": "Column Break"},
    {"fieldname": "country", "fieldtype": "Link", "label": "Country", "options": "Country"},
    {"fieldname": "company", "fieldtype": "Link", "label": "Company", "options": "Company"},
    {"fieldname": "role", "fieldtype": "Data", "label": "Role"},
    {"fieldname": "platform", "fieldtype": "Select", "label": "Platform", "options": "\nWeb\nAndroid\niOS"},
    {"fieldname": "section_schedule", "fieldtype": "Section Break", "label": "Schedule"},
    {"fieldname": "start_date", "fieldtype": "Date", "label": "Start Date"},
    {"fieldname": "end_date", "fieldtype": "Date", "label": "End Date"},
    {"fieldname": "rollout_percentage", "fieldtype": "Percent", "label": "Rollout Percentage", "default": "100"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}]
}
